# Copie para .env e preencha. Nunca commite valores reais.
# Frontend (Vite — apenas VITE_* é exposto no navegador)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_HOTMART_CHECKOUT_URL=
VITE_APP_URL=
VITE_SUPPORT_EMAIL=

# Servidor (Netlify Functions — NUNCA prefixar com VITE_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HOTMART_CHECKOUT_URL=
HOTMART_HOTTOK=
